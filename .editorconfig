root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown keeps hard-wrapped prose; trailing spaces there are meaningful line breaks.
[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,scss,html}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml,xaml}]
indent_size = 2

[*.{ps1,psm1,psd1}]
indent_size = 4

[*.{sh}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.{cs}]
indent_size = 4
# The solution uses file-scoped namespaces and 4-space indentation; csharpier is not configured,
# so this only records the convention.
