###############################################################################
# MusicHub Enterprise - container deployment environment template
#
# Copy this file to `.env` in the repository root and replace every CHANGE_ME value.
# The compose file consumes it explicitly:
#
#   docker compose --env-file .env -f deploy/docker/docker-compose.yml up -d --build
#
# NEVER commit the real `.env`. NEVER reuse the placeholder values below. Generate every
# secret with a cryptographically secure random generator (see deploy/docker/README.md).
#
# This file is for containers only. The Windows/native developer stack reads its secrets from
# storage/dev.secrets.ps1 (created by deploy/scripts/start-dev.ps1), not from here.
###############################################################################

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17.11-bookworm
POSTGRES_DB=musichub
POSTGRES_USER=musichub
# Generate: openssl rand -hex 32   (or the PowerShell equivalent in the README).
# Keep it URL-safe: avoid ';' and '"' because the value is embedded in an Npgsql connection
# string, and avoid '$' because compose interpolates it.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password_hex

# -----------------------------------------------------------------------------
# MusicHub application secrets
# -----------------------------------------------------------------------------
# Signing key for JWT access/refresh/stream tokens. Minimum 32 characters; the API refuses to
# start otherwise. Rotating it signs every user out and invalidates outstanding stream URLs.
# Generate: openssl rand -hex 64
MUSICHUB_JWT_SECRET=CHANGE_ME_64_byte_hex_secret

# One-time token for POST /api/setup/initialize. Leave empty after the first administrator
# account exists so bootstrap stays disabled (the endpoint then answers 503).
# Generate: openssl rand -hex 32
MUSICHUB_BOOTSTRAP_TOKEN=CHANGE_ME_one_time_bootstrap_token

# Public origin used by the Android/desktop pairing QR payload. Must be the exact URL clients
# use (scheme, host, no trailing slash). Must match MUSICHUB_PUBLIC_HOSTNAME. Leave it empty to
# derive the origin from the request, and the API refuses to start a pairing session with a value
# that is not an absolute http(s) URL rather than emit a QR code no client can parse.
MUSICHUB_PUBLIC_URL=https://music.example.com

# -----------------------------------------------------------------------------
# Reverse proxy trust
# -----------------------------------------------------------------------------
# Comma-separated: the proxies (or CIDR ranges) whose X-Forwarded-For / X-Forwarded-Proto headers
# the API believes. Anything not listed is ignored, so a direct caller cannot forge a client IP to
# escape the per-IP rate limit or poison audit records. Set this to the proxy network, never to
# 0.0.0.0/0. Leave both empty when nothing sits in front of the API.
# The docker-compose network pins the edge subnet to 172.28.0.0/24 to match the default.
MUSICHUB_TRUSTED_PROXY_NETWORKS=172.28.0.0/24
MUSICHUB_EDGE_SUBNET=172.28.0.0/24
# MUSICHUB_TRUSTED_PROXY_ADDRESSES=172.28.0.10
# Number of proxy hops to walk in X-Forwarded-For. 1 (the default) is correct for one proxy.
# MUSICHUB_TRUSTED_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Edge / TLS
# -----------------------------------------------------------------------------
# Public DNS name that resolves to this host. Caddy obtains a real certificate for it.
# deploy/docker/install.ps1 rewrites the example value below to `localhost` (Caddy's local CA)
# unless you pass -PublicHostname, so a LAN-only install never requests a certificate for a
# domain you do not own. Set a real name here only when DNS for it points at this machine.
MUSICHUB_PUBLIC_HOSTNAME=music.example.com
# ACME account contact address (no real personal address in the committed template).
MUSICHUB_ACME_EMAIL=admin@example.com
CADDY_IMAGE=caddy:2.11.9-alpine

# -----------------------------------------------------------------------------
# LAN access (optional, written by deploy/docker/install.ps1)
# -----------------------------------------------------------------------------
# Publishing the dashboard on this host's LAN address lets phones and other devices reach it
# without a public DNS name. deploy/docker/install.ps1 detects the address, asks which port to
# use, and writes both values here; docker-compose.lan.yml has no literal and fails loudly when
# either is missing. Never expose this port to the internet: the API has no TLS listener.
# MUSICHUB_LAN_ADDRESS=192.168.1.10
# MUSICHUB_LAN_PORT=8090

# -----------------------------------------------------------------------------
# Runtime behaviour
# -----------------------------------------------------------------------------
# Production enables the strict security headers and disables EF Core developer diagnostics.
ASPNETCORE_ENVIRONMENT=Production
# Apply pending EF Core migrations when the API starts. Only for a single API instance.
MUSICHUB_MIGRATE_ON_STARTUP=true
# UTC is recommended; change only if library timestamps must follow local time.
MUSICHUB_TIMEZONE=UTC
# Reject uploads unless a ClamAV scan succeeds. When true, MUSICHUB_CLAMAV_HOST must be set.
MUSICHUB_REQUIRE_MALWARE_SCAN=false
MUSICHUB_CLAMAV_HOST=
# The worker's Telegram polling/publishing loops. Disable to run a maintenance-only worker.
MUSICHUB_TELEGRAM_WORKER_ENABLED=true
# Fail the API image build when the dashboard bundle is missing from wwwroot.
MUSICHUB_REQUIRE_DASHBOARD=false

# -----------------------------------------------------------------------------
# Images, resource limits
# -----------------------------------------------------------------------------
MUSICHUB_IMAGE_TAG=local
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.404-noble
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0.9-noble
WEB_NODE_IMAGE=node:22-alpine

MUSICHUB_POSTGRES_CPUS=2.0
MUSICHUB_POSTGRES_MEMORY=2g
MUSICHUB_API_CPUS=2.0
MUSICHUB_API_MEMORY=2g
MUSICHUB_WORKER_CPUS=2.0
MUSICHUB_WORKER_MEMORY=2g
MUSICHUB_CADDY_CPUS=1.0
MUSICHUB_CADDY_MEMORY=256m

# -----------------------------------------------------------------------------
# Optional: CORS for cross-origin browser clients
# -----------------------------------------------------------------------------
# Not set by the default compose file. The dashboard is served from the same origin, so it needs
# no CORS entry. Only add these to a compose override when a browser client on another origin
# must call the API directly (never use '*' - it is incompatible with credentialed requests):
#
#   Cors__AllowedOrigins__0=https://other.example.com
