.gradle/
local.properties
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/

# Runtime data and secrets.
#
# The leading slash anchors `storage/` and `artifacts/` to the repository root. Without it,
# `storage/` also matched any directory named `storage` or `Storage` at any depth, and because
# Git's ignore matching is case-insensitive on Windows and macOS it silently swallowed
# `src/server/MusicHub.Infrastructure/Storage/` - real source code, which then never entered the
# repository and broke the Linux build (B-097). The remaining patterns stay unanchored on purpose:
# a secret or a log file must be ignored wherever it appears.
/storage/
/artifacts/
*.log
*.env
dev.secrets.ps1
.env
.env.*
# Keep the documented template; it must never contain real secrets.
!/.env.example

# Test output
TestResults/
coverage/
*.trx

# IDE
.vs/
.idea/
*.user
*.suo

# Local agent tooling (not part of the product; never published)
.opencode/
.agents/

