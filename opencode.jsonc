{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "music-orchestrator",
  "instructions": [
    "AGENTS.md",
    "docs/AGENT_OPERATING_PROTOCOL.md"
  ],
  "experimental": {
    "subagent_depth": 1,
    "todo": true
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*Remove-Item * -Recurse*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*DROP DATABASE*",
      "effect": "ask"
    }
  ],
  "agents": {
    "music-orchestrator": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
