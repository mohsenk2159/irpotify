<Window x:Class="MusicHub.Player.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicHub Player — Sign in"
        Width="1000" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Brand panel -->
            <Border Grid.Column="0" MouseLeftButtonDown="BrandPanel_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#16233A" Offset="0" />
                        <GradientStop Color="#0F1A2A" Offset="0.55" />
                        <GradientStop Color="#131C2B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="48,44">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Accent}">
                            <TextBlock Text="♪" FontSize="22" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MusicHub" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="ENTERPRISE PLAYER" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Your library.&#10;Anywhere on your network." FontSize="34" FontWeight="SemiBold"
                                   LineHeight="44" TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,0" FontSize="14" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                   Text="Sign in with the account your administrator created in the MusicHub dashboard. The player connects directly to your server over LAN, VPN or a secure tunnel." />
                        <StackPanel Margin="0,32,0,0">
                            <TextBlock Text="✓  FLAC, MP3, M4A, OGG, OPUS, WAV" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="✓  Albums, artists, playlists and favorites" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="✓  Keyboard shortcuts and gapless queue" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
                            <TextBlock Text="✓  Tokens stored with Windows DPAPI" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="MusicHub Enterprise · Player 1.0.0" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                </Grid>
            </Border>

            <!-- Form panel -->
            <Grid Grid.Column="1" Background="{StaticResource PanelBackground}">
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                        Style="{StaticResource IconButton}" Content="✕" Click="Close_Click" ToolTip="Close" />

                <StackPanel Margin="56,0,56,0" VerticalAlignment="Center">
                    <TextBlock Text="Sign in" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Use your MusicHub account to start listening." Foreground="{StaticResource TextSecondary}"
                               Margin="0,8,0,30" />

                    <TextBlock Text="SERVER ADDRESS" Style="{StaticResource Label}" />
                    <TextBox x:Name="ServerBox" ToolTip="Example: http://192.168.1.20:5080 or https://music.example.com" />
                    <TextBlock Text="IP address with port, or a domain. HTTPS is recommended when the server is exposed to the internet."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="EMAIL" Style="{StaticResource Label}" Margin="0,20,0,6" />
                    <TextBox x:Name="EmailBox" />

                    <TextBlock Text="PASSWORD" Style="{StaticResource Label}" Margin="0,20,0,6" />
                    <PasswordBox x:Name="PasswordBox" />

                    <CheckBox x:Name="RememberBox" Content="Remember this device" Margin="0,18,0,0" IsChecked="True"
                              ToolTip="Stores the tokens encrypted for your Windows user with DPAPI." />

                    <Border x:Name="ErrorBanner" Style="{StaticResource ErrorBanner}" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>

                    <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Height="44"
                            Content="Sign in" Click="SignIn_Click" IsDefault="True" />
                    <TextBlock x:Name="BusyText" Text="Connecting to the server…" Foreground="{StaticResource TextSecondary}"
                               Margin="0,12,0,0" Visibility="Collapsed" />

                    <TextBlock Margin="0,26,0,0" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Text="No access? Ask an administrator to enable “Allow player application” for your account in the dashboard." />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
