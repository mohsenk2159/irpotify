<Window x:Class="MusicHub.Player.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:MusicHub.Player.Converters"
        Title="MusicHub Player"
        Width="1320" Height="840" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource AppBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="TrackRowTemplate">
            <Border Style="{StaticResource HoverRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="8" Background="#22314A" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold" Foreground="#9DB8E8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding FavoriteGlyph}" FontSize="15" Style="{StaticResource IconButton}"
                                ToolTip="Toggle favorite"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="▶" FontSize="13" Style="{StaticResource IconButton}" ToolTip="Play"
                                Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Button Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <Border Height="132" CornerRadius="10" Background="#22314A" Margin="0,0,0,10">
                        <Grid>
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2C4675" Offset="0" />
                                        <GradientStop Color="#1B2A40" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="SemiBold" Foreground="#A9C2F5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Background="#121A24" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="8">
                                <TextBlock Text="{Binding Badge}" FontSize="9.5" Foreground="{StaticResource TextMuted}" />
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="QueueRowTemplate">
            <Border Style="{StaticResource HoverRow}" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="▶" FontSize="11" Style="{StaticResource IconButton}"
                            Command="{Binding DataContext.PlayQueueItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#0A0F15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Accent}">
                        <TextBlock Text="♪" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MusicHub Player" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ServerUrl}" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Minimize" Width="44" Height="42" />
                    <Button Content="□" Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="Maximize" Width="44" Height="42" />
                    <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close" Width="44" Height="42" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="98" />
                </Grid.RowDefinitions>

                <!-- Sidebar -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="NavList" Style="{StaticResource NavList}" Margin="12,16,12,0"
                                 SelectionChanged="NavList_SelectionChanged">
                            <ListBoxItem Tag="Home">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" Width="26" FontSize="15" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Search">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌕" Width="26" FontSize="16" />
                                    <TextBlock Text="Search" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Tracks">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♫" Width="26" FontSize="15" />
                                    <TextBlock Text="Tracks" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Albums">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▤" Width="26" FontSize="15" />
                                    <TextBlock Text="Albums" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Artists">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☺" Width="26" FontSize="15" />
                                    <TextBlock Text="Artists" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Playlists">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="≡" Width="26" FontSize="15" />
                                    <TextBlock Text="Playlists" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Favorites">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" Width="26" FontSize="14" />
                                    <TextBlock Text="Favorites" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Width="26" FontSize="15" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Storage" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣" Width="26" FontSize="15" />
                                    <TextBlock Text="Storage" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding UserDisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UserEmail}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding UserRole}" FontSize="10.5" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main content -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="24,16,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="260" Margin="0,0,0,0">
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchBox_KeyDown" ToolTip="Search and press Enter" />
                                <TextBlock Text="Search your library…" IsHitTestVisible="False" Margin="14,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="13"
                                           Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                            <Button Content="⌕" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Search"
                                    Command="{Binding SearchCommand}" />
                            <Button Content="⟳" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="Refresh"
                                    Command="{Binding RefreshCommand}" />
                            <Button Content="☰" Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="Queue"
                                    Command="{Binding ToggleQueueCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource ErrorBanner}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12.5" />
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Command="{Binding ClearErrorCommand}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <!-- Home -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,12,24">
                                <TextBlock Text="Recently added" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource TrackRowTemplate}" />

                                <TextBlock Text="Recently played" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                                <ItemsControl ItemsSource="{Binding RecentlyPlayed}" ItemTemplate="{StaticResource TrackRowTemplate}" />

                                <TextBlock Text="Most played" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                                <ItemsControl ItemsSource="{Binding MostPlayed}" ItemTemplate="{StaticResource TrackRowTemplate}" />

                                <TextBlock Text="Albums" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                                <ItemsControl ItemsSource="{Binding HomeAlbums}" ItemTemplate="{StaticResource CardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Plain track list (Tracks / Favorites) -->
                        <ListBox ItemsSource="{Binding Tracks}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                 Style="{StaticResource TrackList}" MouseDoubleClick="TrackList_MouseDoubleClick"
                                 Visibility="{Binding IsPlainTrackView, Converter={StaticResource BoolToVis}}" />

                        <!-- Cards (Albums / Artists / Playlists) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Button Content="+ New playlist" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Margin="0,0,0,16" Click="NewPlaylist_Click"
                                        Visibility="{Binding IsPlaylistsView, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding EmptyCardsMessage}" Style="{StaticResource Muted}" Margin="2,4,0,12"
                                           Visibility="{Binding HasNoCards, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Detail (album / artist / playlist) -->
                        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="←" Style="{StaticResource IconButton}" Command="{Binding CloseDetailCommand}" ToolTip="Back" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DetailTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DetailSubtitle}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="▶  Play all" Style="{StaticResource PrimaryButton}" Command="{Binding PlayDetailCommand}" />
                                    <Button Content="Delete playlist" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="DeletePlaylist_Click"
                                            Visibility="{Binding CanEditPlaylist, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding DetailTracks}" ItemTemplate="{StaticResource TrackRowTemplate}"
                                     Style="{StaticResource TrackList}" MouseDoubleClick="DetailList_MouseDoubleClick" />
                        </Grid>

                        <!-- Search -->
                        <Grid Visibility="{Binding IsSearchView, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Search your library and press Enter." Style="{StaticResource Muted}"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSearched, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="0,0,12,24">
                                    <TextBlock Text="Tracks" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding SearchTracks}" ItemTemplate="{StaticResource TrackRowTemplate}" />
                                    <TextBlock Text="Albums and artists" Style="{StaticResource SectionTitle}" Margin="0,22,0,10" />
                                    <ItemsControl ItemsSource="{Binding SearchCards}" ItemTemplate="{StaticResource CardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Settings -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}">
                            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,24">
                                <Border Style="{StaticResource QueuePanel}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding UserDisplayName}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UserEmail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding UserRole}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding ServerUrl}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Open web dashboard" Style="{StaticResource GhostButton}" Click="OpenDashboard_Click" />
                                            <Button Content="Sign out" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SignOut_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource QueuePanel}" Padding="18" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Space toggles play/pause, Ctrl+Left/Right skips tracks, Ctrl+F focuses search, Ctrl+Q opens the queue."
                                                   Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <TextBlock Text="Open audio formats: FLAC, MP3, M4A/AAC, OGG, OPUS and WAV (decoded by LibVLC)."
                                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="Your access and refresh tokens are encrypted with Windows DPAPI for this Windows user."
                                                   Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="MusicHub Player 1.0.0 · MusicHub Enterprise" Style="{StaticResource Muted}" Margin="0,16,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Admin: library storage location -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStorageView, Converter={StaticResource BoolToVis}}">
                            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,24">
                                <Border Style="{StaticResource QueuePanel}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Current location" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding StorageInfo.Library.Path}" FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StorageInfo.Library.SourceText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding StorageInfo.Library.PointerError}" Style="{StaticResource Muted}"
                                                   Foreground="#E0A34A" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding HasPointerError, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding StorageInfo.Assets.Summary}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding StorageDiskText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />

                                        <ItemsControl ItemsSource="{Binding StorageInfo.Library.Areas}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource Muted}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource QueuePanel}" Padding="18" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Move the library" Style="{StaticResource SectionTitle}" />
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                                                   Text="Enter a folder on the server. The music, artwork and quarantine folders are copied there, every stored file is verified against its recorded SHA-256, and only then does the server start using the new folder. The previous copy is kept, so a mistake costs disk space rather than the library. Do not upload while a move is running." />
                                        <TextBox Text="{Binding StoragePathInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0"
                                                 ToolTip="For example D:\MusicHub\library" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Check this folder" Style="{StaticResource GhostButton}"
                                                    Command="{Binding CheckStoragePathCommand}" />
                                            <Button Content="{Binding StorageRelocateLabel}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                    Command="{Binding RelocateStorageCommand}"
                                                    IsEnabled="{Binding StorageCanRelocate}" />
                                            <Button Content="⟳" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Refresh"
                                                    Command="{Binding RefreshStorageCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StorageMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Visibility="{Binding HasStorageMessage, Converter={StaticResource BoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding StorageChecks}" Margin="0,10,0,0"
                                                      Visibility="{Binding HasStorageChecks, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Mark}" FontWeight="Bold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource QueuePanel}" Padding="18" Margin="0,14,0,0"
                                        Visibility="{Binding HasStorageProgress, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Move progress" Style="{StaticResource SectionTitle}" />
                                        <ProgressBar Value="{Binding StorageProgressPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,8" />
                                        <TextBlock Text="{Binding StorageProgressText}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                                           Text="Only an administrator sees this screen, and the server checks the account again on every request. The server data folder itself (keys, credentials, logs) is chosen by the operator through MUSICHUB_DATA_ROOT and is not changed here." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Queue overlay -->
                        <Border Style="{StaticResource QueuePanel}" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,4" Padding="12" Visibility="{Binding QueueVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Queue" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource IconButton}" Command="{Binding ToggleQueueCommand}" />
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Queue}" ItemTemplate="{StaticResource QueueRowTemplate}"
                                         Style="{StaticResource TrackList}" Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Player bar -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0A0F15"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="54" Height="54" CornerRadius="8" Background="#22314A" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding CurrentInitial}" FontSize="20" FontWeight="SemiBold" Foreground="#A9C2F5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding CurrentArtwork}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentSubtitle}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding CurrentTrack.FavoriteGlyph, FallbackValue=☆}" Style="{StaticResource IconButton}"
                                        Command="{Binding TogglePlaylistFavoriteCommand}" ToolTip="Toggle favorite" />
                                <Button Content="＋" Style="{StaticResource IconButton}" Click="AddToPlaylist_Click" ToolTip="Add to playlist" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <Button Content="{Binding ShuffleGlyph}" Style="{StaticResource IconButton}" Command="{Binding ToggleShuffleCommand}"
                                        ToolTip="Toggle shuffle" FontSize="13" />
                                <Button Content="⏮" Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" ToolTip="Previous" FontSize="15" />
                                <Button Content="{Binding PlayPauseGlyph}" Style="{StaticResource PlayButton}" Margin="4,0"
                                        Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseTooltip}" />
                                <Button Content="⏭" Style="{StaticResource IconButton}" Command="{Binding NextCommand}" ToolTip="Next" FontSize="15" />
                                <Button Content="{Binding RepeatGlyph}" Style="{StaticResource IconButton}" Command="{Binding CycleRepeatCommand}"
                                        ToolTip="{Binding RepeatTooltip}" FontSize="13" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0"
                                        Maximum="{Binding DurationSeconds, Mode=OneWay}"
                                        Value="{Binding PositionSeconds, Mode=OneWay}"
                                        IsMoveToPointEnabled="True"
                                        Thumb.DragStarted="SeekSlider_DragStarted"
                                        Thumb.DragCompleted="SeekSlider_DragCompleted"
                                        PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp" />
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding VolumeGlyph}" Style="{StaticResource IconButton}" Command="{Binding ToggleMuteCommand}" ToolTip="Mute" FontSize="14" />
                            <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center"
                                    ToolTip="Volume" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
